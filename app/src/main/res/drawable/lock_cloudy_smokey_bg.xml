<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Dark Charcoal Background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#0F131C"
                android:centerColor="#141824"
                android:endColor="#181D2A" />
        </shape>
    </item>

    <!-- Top Soft Cloudy White Patch -->
    <item
        android:left="-50dp"
        android:top="-50dp"
        android:right="-50dp"
        android:bottom="300dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="350dp"
                android:startColor="#1AFFFFFF"
                android:centerColor="#0DFFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Center Soft Cloudy White Smoke Patch -->
    <item
        android:left="-20dp"
        android:top="150dp"
        android:right="-20dp"
        android:bottom="150dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="300dp"
                android:startColor="#15FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
