<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/circle_bg">

    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New Daily Task"
        android:textColor="#1E1E2C"
        android:textSize="20sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/task_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Task Title (e.g. Morning Workout)"
        android:inputType="textCapSentences"
        android:textColor="#1E1E2C"
        android:textColorHint="#9E9E9E"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/task_desc_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Notes / Details (Optional)"
        android:inputType="textCapSentences"
        android:textColor="#1E1E2C"
        android:textColorHint="#9E9E9E"
        android:textSize="14sp" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/cancel_task_btn"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="#6C757D" />

        <Button
            android:id="@+id/save_task_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#3F5AA9"
            android:text="Add Task"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</LinearLayout>