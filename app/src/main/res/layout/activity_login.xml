<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white">


    <!-- Blue Circle -->
    <View
        android:id="@+id/blueCircle"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/login_circle_blue"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="35dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>



    <!-- White Tick Icon -->
    <ImageView
        android:id="@+id/tickIcon"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/login_ic_check"
        app:layout_constraintTop_toTopOf="@id/blueCircle"
        app:layout_constraintBottom_toBottomOf="@id/blueCircle"
        app:layout_constraintStart_toStartOf="@id/blueCircle"
        app:layout_constraintEnd_toEndOf="@id/blueCircle"/>


    <!-- Text below circle -->
    <TextView
        android:id="@+id/welcomeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome Back"
        android:textSize="40sp"
        android:textColor="@android:color/black"
        android:layout_marginTop="35dp"
        app:layout_constraintTop_toBottomOf="@id/blueCircle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!-- Subtitle text -->
    <TextView
        android:id="@+id/subText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Stay focused, Small tasks, Big discipline"
        android:textSize="15sp"
        android:textColor="@color/black"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/welcomeText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <RelativeLayout
        android:id="@+id/login_box1"
        android:layout_width="330dp"
        android:layout_height="55dp"
        android:background="@drawable/signup_edittext_bg"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/subText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Icon -->

        <ImageView
            android:id="@+id/name_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"/>

        <!--        android:src="@drawable/ic_person"-->

        <!-- EditText -->

        <EditText
            android:id="@+id/info_box"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Enter your Email"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:textColorHint="#9E9E9E"
            android:background="@android:color/transparent"
            android:paddingStart="50dp"
            android:paddingEnd="12dp"/>

    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/login_box2"
        android:layout_width="330dp"
        android:layout_height="55dp"
        android:background="@drawable/signup_edittext_bg"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/login_box1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Icon -->

        <ImageView
            android:id="@+id/password_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"/>

        <!--        android:src="@drawable/ic_person"-->

        <!-- EditText -->

        <EditText
            android:id="@+id/info_box_password"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Enter your Password"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:textColorHint="#9E9E9E"
            android:background="@android:color/transparent"
            android:paddingStart="50dp"
            android:paddingEnd="12dp"/>

    </RelativeLayout>



<!--    <TextView-->
<!--        android:id="@+id/or_box"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:text="or use Email"-->
<!--        android:textSize="18sp"-->
<!--        android:textColor="#9E9E9E"-->
<!--        android:textStyle="bold"-->
<!--        android:layout_marginTop="35dp"-->
<!--        app:layout_constraintTop_toBottomOf="@id/login_box1"-->
<!--        app:layout_constraintStart_toStartOf="parent"-->
<!--        app:layout_constraintEnd_toEndOf="parent"/>-->


    <RelativeLayout
        android:id="@+id/login_continue"
        android:layout_width="330dp"
        android:layout_height="55dp"
        android:layout_marginTop="35dp"
        app:layout_constraintTop_toBottomOf="@id/login_box2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <TextView
            android:id="@+id/continue_account"
            android:layout_width="330dp"
            android:layout_height="55dp"
            android:text="Continue"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:background="@drawable/signup_button_bg"/>

    </RelativeLayout>

    <TextView
        android:id="@+id/access_quickly_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ACCESS QUICKLY"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#808080"
        android:layout_marginTop="25dp"
        app:layout_constraintTop_toBottomOf="@id/login_continue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <RelativeLayout
        android:id="@+id/google_login_box"
        android:layout_width="330dp"
        android:layout_height="55dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/google_signup_bg"
        app:layout_constraintTop_toBottomOf="@id/access_quickly_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Google Icon -->

        <!--        <ImageView-->
        <!--            android:id="@+id/google_icon"-->
        <!--            android:layout_width="22dp"-->
        <!--            android:layout_height="22dp"-->
        <!--            android:src="@drawable/google_icon"-->
        <!--            android:layout_centerVertical="true"-->
        <!--            android:layout_marginStart="18dp"/>-->

        <!-- Text -->

        <TextView
            android:id="@+id/google_signup_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign in with Google"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_centerInParent="true"/>

    </RelativeLayout>


    <LinearLayout
        android:id="@+id/sign_up_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/google_login_box"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Don't have an account? "
            android:textSize="18sp"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/signup_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign up"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#4F7CFF" />

    </LinearLayout>


    <TextView
        android:id="@+id/privacy_text"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:text="We respect your privacy"
        android:textSize="15sp"
        android:textColor="#5B7BE3"
        android:gravity="center"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/sign_up_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <View
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:layout_constraintTop_toBottomOf="@id/privacy_text"/>



</androidx.constraintlayout.widget.ConstraintLayout>