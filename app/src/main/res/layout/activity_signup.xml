<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingBottom="24dp"
        tools:context=".SignupActivity">

        <!-- Sign Up Text -->
        <TextView
            android:id="@+id/signup_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign Up"
            android:textSize="30sp"
            android:textColor="@color/black"
            android:layout_marginTop="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <RelativeLayout
            android:id="@+id/signup_box1"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="36dp"
            android:layout_marginEnd="36dp"
            android:background="@drawable/signup_edittext_bg"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/signup_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <EditText
                android:id="@+id/full_name"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Full Name"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textColorHint="#9E9E9E"
                android:background="@android:color/transparent"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"/>

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/signup_box2"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="36dp"
            android:layout_marginEnd="36dp"
            android:background="@drawable/signup_edittext_bg"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/signup_box1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <EditText
                android:id="@+id/Enter_Email"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Enter Email"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textColorHint="#9E9E9E"
                android:background="@android:color/transparent"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"/>

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/signup_box3"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="36dp"
            android:layout_marginEnd="36dp"
            android:background="@drawable/signup_edittext_bg"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/signup_box2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <EditText
                android:id="@+id/create_password"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Create Password"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textColorHint="#9E9E9E"
                android:background="@android:color/transparent"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"/>

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/signup_box4"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="36dp"
            android:layout_marginEnd="36dp"
            android:background="@drawable/signup_edittext_bg"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/signup_box3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <EditText
                android:id="@+id/confirm_password"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Confirm Password"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:textColorHint="#9E9E9E"
                android:background="@android:color/transparent"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"/>

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/signup_box5"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginStart="36dp"
            android:layout_marginEnd="36dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/signup_box4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/create_account"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Create Account"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:background="@drawable/signup_button_bg"/>

        </RelativeLayout>

        <TextView
            android:id="@+id/access_quickly_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OR"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/signup_box5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <RelativeLayout
            android:id="@+id/google_signup_box"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginStart="36dp"
            android:layout_marginEnd="36dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/google_signup_bg"
            app:layout_constraintTop_toBottomOf="@id/access_quickly_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/google_signup_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign in with Google"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_centerInParent="true"/>

        </RelativeLayout>

        <LinearLayout
            android:id="@+id/login_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/google_signup_box"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? "
                android:textSize="18sp"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/login_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log In"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#4F7CFF" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>