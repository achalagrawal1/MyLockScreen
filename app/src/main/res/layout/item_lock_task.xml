<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="4dp"
    app:strokeColor="#35FFFFFF"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="#00000000">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/lock_card_glass_bg"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/taskNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="1."
            android:textColor="#E2E8F0"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/lockTaskAlarmIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentStart="true"
            android:layout_marginTop="2dp"
            android:src="@android:drawable/ic_lock_idle_alarm"
            app:tint="#FFFFFF"
            android:contentDescription="Clock" />

        <TextView
            android:id="@+id/taskTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/lockTaskAlarmIcon"
            android:layout_marginStart="12dp"
            android:text="Study"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/taskTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/taskTitle"
            android:layout_toEndOf="@id/lockTaskAlarmIcon"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:text="Due in 45 mins • Tap to done"
            android:textColor="#CBD5E1"
            android:textSize="14sp" />

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>