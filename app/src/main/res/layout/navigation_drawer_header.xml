<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FAFAFC"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp"
        android:background="#FAFAFC">

        <!-- Top Wave Branding Header -->
        <RelativeLayout
            android:id="@+id/app_branding_layout"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="@drawable/drawer_header_wave_bg"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <!-- Decorative Blue Circles -->
            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="28dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/blue_circle_icon_bg" />

            <View
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="16dp"
                android:background="@drawable/blue_circle_icon_bg" />

            <!-- App Logo + Title Branding Layout (No White Box) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/app_logo"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/antron_logo"
                    android:contentDescription="Antron Logo" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="afteron"
                        android:textColor="#0F172A"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Smarter. Simpler. Together."
                        android:textColor="#64748B"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>

        <!-- Menu Navigation Items -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <!-- Item 1: Home -->
            <RelativeLayout
                android:id="@+id/drawer_item_home"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/icon_home"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="20dp"
                    android:padding="3dp"
                    android:src="@android:drawable/ic_menu_today"
                    app:tint="#475569"
                    android:contentDescription="Home" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon_home"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"
                    android:text="Home"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <!-- Item 2: Settings (Selected Active Pill State aligned perfectly) -->
            <RelativeLayout
                android:id="@+id/drawer_item_settings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/selected_menu_pill_bg">

                <!-- Left Blue Bar Indicator -->
                <View
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="#2563EB" />

                <!-- Circular Blue Icon Background -->
                <RelativeLayout
                    android:id="@+id/settings_icon_container"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:layout_centerVertical="true"
                    android:background="@drawable/blue_circle_icon_bg">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_centerInParent="true"
                        android:src="@android:drawable/ic_menu_preferences"
                        app:tint="#FFFFFF"
                        android:contentDescription="Settings" />

                </RelativeLayout>

                <TextView
                    android:id="@+id/drawer_text_settings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/settings_icon_container"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"
                    android:text="Settings"
                    android:textColor="#1D4ED8"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <!-- Item 3: Share -->
            <RelativeLayout
                android:id="@+id/drawer_item_share"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/icon_share"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="20dp"
                    android:padding="3dp"
                    android:src="@android:drawable/ic_menu_share"
                    app:tint="#475569"
                    android:contentDescription="Share" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon_share"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"
                    android:text="Share"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <!-- Item 4: About -->
            <RelativeLayout
                android:id="@+id/drawer_item_about"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/icon_about"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="20dp"
                    android:padding="3dp"
                    android:src="@android:drawable/ic_menu_info_details"
                    app:tint="#475569"
                    android:contentDescription="About" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon_about"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"
                    android:text="About"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </RelativeLayout>

        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#E2E8F0" />

        <!-- Go Premium Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_go_premium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="#F1F5F9"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#FFFFFF">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/icon_star"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:src="@android:drawable/btn_star_big_off"
                    app:tint="#475569"
                    android:contentDescription="Premium" />

                <TextView
                    android:id="@+id/title_premium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon_star"
                    android:layout_marginStart="14dp"
                    android:text="Go Premium"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/title_premium"
                    android:layout_toEndOf="@id/icon_star"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="2dp"
                    android:text="Unlock advanced features"
                    android:textColor="#64748B"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/profile_box_arrow"
                    app:tint="#64748B"
                    android:contentDescription="Arrow" />

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#E2E8F0" />

        <!-- Logout Item -->
        <RelativeLayout
            android:id="@+id/drawer_item_logout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/icon_logout"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="20dp"
                android:padding="3dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#DC2626"
                android:contentDescription="Logout" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/icon_logout"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:text="Logout"
                android:textColor="#DC2626"
                android:textSize="16sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- Bottom Version Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="28dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="#F1F5F9"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#FFFFFF">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <RelativeLayout
                    android:id="@+id/shield_icon_container"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/selected_menu_pill_bg">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_centerInParent="true"
                        android:src="@android:drawable/ic_secure"
                        app:tint="#2563EB"
                        android:contentDescription="Security Shield" />

                </RelativeLayout>

                <TextView
                    android:id="@+id/title_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/shield_icon_container"
                    android:layout_marginStart="14dp"
                    android:text="Version 1.2.0"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/title_version"
                    android:layout_toEndOf="@id/shield_icon_container"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="2dp"
                    android:text="Secure • Reliable • Always"
                    android:textColor="#64748B"
                    android:textSize="12sp" />

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>