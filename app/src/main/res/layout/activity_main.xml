<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/homepage_background"
    tools:context=".MainActivity"
    android:id="@+id/drawer_layout">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/box1"
            android:paddingBottom="24dp">

            <!-- Top Header Bar -->
            <RelativeLayout
                android:id="@+id/header_box"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="#0D2040"
                android:elevation="4dp">

                <LinearLayout
                    android:id="@+id/menu_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="22dp"
                        android:layout_height="2.5dp"
                        android:background="#E2E8F0" />

                    <View
                        android:layout_width="22dp"
                        android:layout_height="2.5dp"
                        android:layout_marginTop="4dp"
                        android:background="#E2E8F0" />

                    <View
                        android:layout_width="22dp"
                        android:layout_height="2.5dp"
                        android:layout_marginTop="4dp"
                        android:background="#E2E8F0" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/profile_circle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/circle_metallic_ring"
                    android:src="@drawable/circle_bg"
                    android:scaleType="centerCrop"
                    android:padding="2.5dp"
                    android:clipToOutline="true" />

            </RelativeLayout>

            <!-- Header Title -->
            <RelativeLayout
                android:id="@+id/planner_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/header_box"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/todayHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:text="Today"
                    android:textColor="#0D2040"
                    android:textSize="26sp"
                    android:textStyle="bold" />

            </RelativeLayout>

            <!-- Floating Glass Task Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/plannerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/planner_header"
                android:layout_marginStart="24dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="32dp"
                app:cardElevation="8dp"
                app:strokeColor="#FFFFFF"
                app:contentPadding="0dp"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:id="@+id/plannerContainer"
                    android:layout_width="match_parent"
                    android:layout_height="415dp"
                    android:background="@drawable/planner_glass_bg"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="16dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/todayTasksRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="310dp"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1.5dp"
                        android:layout_marginStart="-20dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="-20dp"
                        android:layout_marginBottom="12dp"
                        android:background="#D0DCED" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/doneBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="29dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="1dp"
                        android:background="@drawable/button_bg"
                        android:backgroundTint="@null"
                        android:text="Done"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Glowing Blue Halo Circle -->
            <LinearLayout
                android:id="@+id/dotIndicator"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_below="@id/plannerCard"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="4dp"
                android:background="@drawable/glowing_ring"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal" />

            <!-- 3D Capsule Add Task Button -->
            <ImageButton
                android:id="@+id/addBtn"
                android:layout_width="120dp"
                android:layout_height="46dp"
                android:layout_below="@id/dotIndicator"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="16dp"
                android:background="@drawable/add_button_3d_bg"
                app:srcCompat="@drawable/outline_add_24"
                app:tint="#FFFFFF"
                android:elevation="6dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="Add Task" />

            <!-- Tomorrow's Glimpse Section Header -->
            <TextView
                android:id="@+id/tomorrows_glimpse_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/addBtn"
                android:layout_marginStart="28dp"
                android:layout_marginTop="20dp"
                android:text="Tomorrow's Glimpse"
                android:textColor="#0D2040"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Tomorrow's Glimpse Preview Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tomorrowsGlimpseCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tomorrows_glimpse_title"
                android:layout_marginStart="24dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeColor="#FFFFFF"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glimpse_card_bg"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@android:drawable/ic_menu_recent_history"
                        app:tint="#475569"
                        android:contentDescription="Clock" />

                    <TextView
                        android:id="@+id/glimpseTaskTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Complete C.S. hour"
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </RelativeLayout>

    </ScrollView>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/navigation_drawer_header"
        app:menu="@menu/navigation_menu" />

</androidx.drawerlayout.widget.DrawerLayout>