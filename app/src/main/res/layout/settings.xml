<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#ECEEF5">

    <LinearLayout
        android:id="@+id/settings_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp"
        android:background="#ECEEF5"
        tools:context=".SettingsActivity">

        <!-- Top Header Bar -->
        <RelativeLayout
            android:id="@+id/box1"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@android:color/transparent">

            <!-- Left Back Arrow -->
            <ImageView
                android:id="@+id/setting_arrow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/setting_arrow"
                android:contentDescription="Back"
                app:tint="#1D263B" />

            <!-- Center Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Settings"
                android:textColor="#2D3748"
                android:textSize="22sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- SECTION 1: GENERAL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="4dp"
            android:text="GENERAL"
            android:textColor="#8F9BB3"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_general"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Item 1: Time & Date -->
                <RelativeLayout
                    android:id="@+id/box2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/time_date_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Time &amp; Date"
                        android:textColor="#1E293B"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/time_date_title"
                        android:layout_marginTop="2dp"
                        android:text="Show time &amp; date"
                        android:textColor="#64748B"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchbtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="15dp"
                        android:checked="true"
                        app:thumbTint="@color/switch_thumb"
                        app:trackTint="@color/switch_track" />

                </RelativeLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="#EDF2F7" />

                <!-- Item 2: Task Interface Theme -->
                <RelativeLayout
                    android:id="@+id/box3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/theme_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Task Interface Theme"
                        android:textColor="#1E293B"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/theme_selector"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_below="@id/theme_text"
                        android:layout_marginTop="12dp"
                        android:background="#718096"
                        android:padding="2dp"
                        android:orientation="horizontal">

                        <!-- Light -->
                        <TextView
                            android:id="@+id/light_btn"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#4B8CF2"
                            android:gravity="center"
                            android:text="Light"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Dark -->
                        <TextView
                            android:id="@+id/dark_btn"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:text="Dark"
                            android:textColor="#CBD5E1"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </RelativeLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- SECTION 2: DISPLAY & LAYOUT -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="4dp"
            android:text="DISPLAY &amp; LAYOUT"
            android:textColor="#8F9BB3"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Display Density -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/density_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Display Density"
                        android:textColor="#1E293B"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/density_title"
                        android:layout_marginTop="2dp"
                        android:text="Compact / Standard"
                        android:textColor="#64748B"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="15dp"
                        android:checked="false"
                        app:thumbTint="@color/switch_thumb"
                        app:trackTint="@color/switch_track" />

                </RelativeLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="#EDF2F7" />

                <!-- Date Format -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/date_format_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Date Format"
                        android:textColor="#1E293B"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/date_format_title"
                        android:layout_marginTop="2dp"
                        android:text="MM-DD-YYYY / DD-MM-YYYY / YYYY-MM-DD"
                        android:textColor="#64748B"
                        android:textSize="13sp" />

                </RelativeLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- SECTION 3: PREFERENCES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="4dp"
            android:text="PREFERENCES"
            android:textColor="#8F9BB3"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_preferences"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Default Task Priority -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/priority_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Default Task Priority"
                        android:textColor="#1E293B"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/priority_title"
                        android:layout_marginTop="2dp"
                        android:text="Open a bottom sheet with options"
                        android:textColor="#64748B"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Medium  ›"
                        android:textColor="#64748B"
                        android:textSize="15sp" />

                </RelativeLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="#EDF2F7" />

                <!-- Auto-Archive Past Tasks -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/archive_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto-Archive Past Tasks"
                        android:textColor="#1E293B"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/archive_title"
                        android:layout_marginTop="2dp"
                        android:text="Autos-Archive Past Tasks"
                        android:textColor="#64748B"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="15dp"
                        android:checked="false"
                        app:thumbTint="@color/switch_thumb"
                        app:trackTint="@color/switch_track" />

                </RelativeLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Font Size Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/box4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="12dp"
                    android:text="Font Size"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Small Option -->
                <TextView
                    android:id="@+id/font_small"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="small"
                    android:textColor="#1E293B"
                    android:textSize="15sp"
                    android:background="?attr/selectableItemBackground" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="#EDF2F7" />

                <!-- Medium Option -->
                <TextView
                    android:id="@+id/font_medium"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="medium             ✔"
                    android:textColor="#1E293B"
                    android:textSize="15sp"
                    android:background="?attr/selectableItemBackground" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:background="#EDF2F7" />

                <!-- Large Option -->
                <TextView
                    android:id="@+id/font_large"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="large"
                    android:textColor="#1E293B"
                    android:textSize="15sp"
                    android:background="?attr/selectableItemBackground" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Apply Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/doneBtn"
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#4B8CF2"
            android:gravity="center"
            android:text="Apply"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            app:cornerRadius="25dp"
            app:elevation="4dp" />

    </LinearLayout>

</ScrollView>