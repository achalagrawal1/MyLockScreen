<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/settingspage_background"
    tools:context=".SettingsActivity"
    android:id="@+id/settings_layout"
    android:orientation="vertical">
    <!-- Full Page -->


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/settingspage_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0">

        <!-- First white box -->
        <RelativeLayout
            android:id="@+id/box1"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:background="@color/white">


            <!-- Left Arrow -->

            <ImageView
                android:id="@+id/setting_arrow"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentStart="true"
                android:layout_marginStart="15dp"
                android:layout_marginTop="35dp"
                android:src="@drawable/setting_arrow" />


            <!-- Center Text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="25dp"
                android:text="Settings"
                android:textColor="#000000"
                android:textSize="28sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_alignParentBottom="true"
                android:background="#D9D9D9"/>


        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/interface_layout"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_below="@id/box1"
            android:background="@color/Circle_bg_Color">






        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/box2"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_below="@id/interface_layout"
            android:layout_marginTop="1dp"
            android:background="@color/white">

            <!-- Main Text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="12dp"
                android:text="Time &amp; Date"
                android:textColor="#373636"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Small Grey Text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="50dp"
                android:text="Show time &amp; date"
                android:textColor="#888888"
                android:textSize="14sp" />


            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchbtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="15dp"
                android:checked="false"
                app:thumbTint="@color/switch_thumb"
                app:trackTint="@color/switch_track" />


        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/box3"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_below="@id/box2"
            android:layout_marginTop="1dp"
            android:background="@color/white">


            <TextView
                android:id="@+id/theme_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="12dp"
                android:text="Task Interface Theme"
                android:textColor="#373636"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/theme_selector"
                android:layout_width="240dp"
                android:layout_height="35dp"
                android:layout_below="@id/theme_text"
                android:layout_marginTop="16dp"
                android:layout_marginStart="15dp">

                <!-- Light -->

                <TextView
                    android:id="@+id/light_btn"
                    android:layout_width="120dp"
                    android:layout_height="match_parent"
                    android:background="#0064e0"
                    android:gravity="center"
                    android:text="Light"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Dark -->

                <TextView
                    android:id="@+id/dark_btn"
                    android:layout_width="120dp"
                    android:layout_height="match_parent"
                    android:background="#E0E0E0"
                    android:gravity="center"
                    android:text="Dark"
                    android:textColor="@android:color/black"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>



        </RelativeLayout>



        <RelativeLayout
            android:id="@+id/box4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/box3"
            android:layout_marginTop="1dp"
            android:background="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Font Size -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:text="Font Size"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:textColor="#373636"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DDDDDD"/>

                <!-- Small -->
                <TextView
                    android:id="@+id/font_small"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:text="small"
                    android:textSize="18sp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DDDDDD"/>

                <!-- Medium -->
                <TextView
                    android:id="@+id/font_medium"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:text="medium"
                    android:textSize="18sp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DDDDDD"/>

                <!-- Large -->
                <TextView
                    android:id="@+id/font_large"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:text="large"
                    android:textSize="18sp"/>


            </LinearLayout>

        </RelativeLayout>


        <LinearLayout
            android:id="@+id/done_button_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="30dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="34dp"
            android:paddingBottom="24dp"
            android:background="@android:color/transparent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/doneBtn"
                android:layout_width="100dp"
                android:layout_height="56dp"
                android:backgroundTint="#0064e0"
                android:gravity="center"
                android:text="Apply"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                app:cornerRadius="28dp"/>

        </LinearLayout>









    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>