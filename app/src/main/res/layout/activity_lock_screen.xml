<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lock_cloudy_smokey_bg"
    tools:context=".LockScreenActivity">

    <!-- Clock & Date Header -->
    <LinearLayout
        android:id="@+id/clock_header"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_alignParentTop="true"
        android:background="@android:color/transparent"
        android:gravity="center"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/lockClockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="hh:mm a"
            android:format24Hour="HH:mm"
            android:fontFamily="sans-serif-light"
            android:layout_marginTop="40dp"
            android:textColor="#FFFFFF"
            android:textSize="54sp"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/lockDateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="6dp"
            android:text="Saturday, 15 August"
            android:textColor="#E2E8F0"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- RecyclerView for Task Cards -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lockTasksRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/clock_header"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false" />

    <!-- Floating Single App Logo with Soft Ambient Blue Halo Glow & Glass Ring -->


    <FrameLayout
        android:id="@+id/lock_logo_container"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/lock_app_logo"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_centerInParent="true"
            android:src="@drawable/antron_logo"
            android:scaleType="fitCenter"
            android:contentDescription="Antron Logo" />

    </FrameLayout>



</RelativeLayout>