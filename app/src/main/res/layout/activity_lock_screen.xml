<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12121A"
    tools:context=".LockScreenActivity">

    <!-- Clock & Date Header -->
    <LinearLayout
        android:id="@+id/clock_header"
        android:layout_width="match_parent"
        android:layout_height="290dp"
        android:layout_alignParentTop="true"
        android:background="#000000"
        android:gravity="center"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/lockClockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="hh:mm a"
            android:format24Hour="HH:mm"
            android:layout_marginTop="90dp"
            android:textColor="#FFFFFF"
            android:textSize="48sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lockDateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Wednesday, 06 August 2026"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- Background Image / Container -->
    <ImageView
        android:id="@+id/lockImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/clock_header"
        android:background="@drawable/bg_screen"
        android:contentDescription="Lock Screen Background"/>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lockTasksRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:layout_below="@id/clock_header"
        android:layout_marginTop="1dp"
        android:paddingStart="51dp"
        android:paddingEnd="25dp"
        android:paddingTop="45dp"
        android:clipToPadding="false"/>

</RelativeLayout>